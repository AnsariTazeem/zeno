# Explicit root allowlist: keep local research and other projects out of Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/bootstrap.py
!/run_eval.py
!/.env.example
!/requirements.txt
!/reproduction/
!/docs/
!/tools/
!/evidence/
!/tasks/
!/reference/
!/graders/
!/results/
!/transcripts/
!/tests/
!/.github/

# Generated state never belongs in the source import.
**/__pycache__/
**/*.pyc
**/test_workspace/
**/.venv/
**/.env
/reproduction/cache/
